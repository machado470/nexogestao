# DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexogestao?schema=public"

# REDIS
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379

# API
PORT=3000
API_PORT=3000
NODE_ENV=development
EXECUTION_MODE_DEFAULT=manual
PILOT_ADMIN_EMAIL=admin.piloto@nexogestao.local
PILOT_ADMIN_PASSWORD=Admin123!

# CORS
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010

# AUTH
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
# Bootstrap administrativo:
# em production, BOOTSTRAP_SECRET é exigido inclusive para o primeiro ADMIN.
BOOTSTRAP_SECRET=
# Rollout da verificação obrigatória de e-mail no login.
AUTH_ENFORCE_EMAIL_VERIFICATION=false

# EMAIL
# Opcional em dev. Obrigatório em produção para recuperação/verificação por e-mail.
RESEND_API_KEY=
EMAIL_FROM=noreply@nexogestao.com
SENTRY_DSN=

# STRIPE
# Obrigatórias para checkout real (produção/sandbox)
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_WEBHOOK_SECRET=
# Opcional: habilita checkout simulado sem Stripe real (somente ambientes controlados)
BILLING_ENABLE_SIMULATED_CHECKOUT=false

# GOOGLE OAUTH
# Obrigatórias para login Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3010/api/auth/google/callback

# WEB/APP URLs (usado em callbacks seguros)
FRONTEND_URL=http://localhost:3010
APP_URL=http://localhost:3010

# WHATSAPP / Z-API
# Provider padrão local: zapi (envio real)
# Para dev sem envio real, use WHATSAPP_PROVIDER=mock e WHATSAPP_ALLOW_MOCK=true
WHATSAPP_PROVIDER=zapi
WHATSAPP_ALLOW_MOCK=false
# ID da instância no painel Z-API
ZAPI_INSTANCE_ID=
# Token da instância
ZAPI_TOKEN=
# Client Token da conta (header Client-Token)
ZAPI_CLIENT_TOKEN=

# OPTIONAL
PRISMA_SKIP_CONNECT=false

# Operational Actions critical checks
# Default em production: ambos habilitados (valor efetivo=1) quando não definidos.
# Em dev/test: ambos desabilitados por padrão (valor efetivo=0).
# Override explícito: use 1 para forçar, 0 para desativar.
REQUIRE_DATABASE_SMOKE=
OPERATIONAL_ACTIONS_DB_STARTUP_CHECK=
